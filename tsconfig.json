{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2020",

    "types": ["node"],
    "sourceMap": true,

    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "allowJs": true,
  },
  "include": ["**/*.ts", "index.ts", "services/authorize.js", "services/streaming.js"],
  "exclude": ["node_modules", "dist"]
}
